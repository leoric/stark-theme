{
  "name": "Stark Dark",
  "globals": {
    "background": "#282420",
    "foreground": "#e8e4df",
    "caret": "#b898e0",
    "line_highlight": "#2a2622",
    "selection": "#a890d055",
    "selection_foreground": "#e8e4df",
    "gutter": "#1e1b18",
    "gutter_foreground": "#706a62",
    "line_diff_added": "#7cc070",
    "line_diff_modified": "#d8b85a",
    "line_diff_deleted": "#e07a6d",
    "brackets": "#a890d0",
    "brackets_foreground": "#e8e4df",
    "bracket_contents": "#b898e0",
    "bracket_contents_foreground": "#e8e4df",
    "tags": "#b898e0",
    "find_highlight": "#d8b85a",
    "find_highlight_foreground": "#282420",
    "highlight": "#a890d055",
    "highlight_foreground": "#e8e4df",
    "guide": "#3a3530",
    "active_guide": "#a8a29a",
    "stack_guide": "#3a3530",
    "shadow": "#00000030"
  },
  "rules": [
    {
      "name": "Comments",
      "scope": "comment",
      "foreground": "#8a8178",
      "font_style": "italic"
    },
    {
      "name": "Keywords",
      "scope": "keyword, storage",
      "foreground": "#b890d8"
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "foreground": "#b890d8"
    },
    {
      "name": "Strings",
      "scope": "string",
      "foreground": "#7cc070"
    },
    {
      "name": "String escapes",
      "scope": "constant.character.escape",
      "foreground": "#68c0c0"
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "foreground": "#d8b85a"
    },
    {
      "name": "Constants",
      "scope": "constant.language, constant.other",
      "foreground": "#e0a070"
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function",
      "foreground": "#7a9ce0"
    },
    {
      "name": "Types and classes",
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "foreground": "#68c0c0"
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "foreground": "#e8e4df"
    },
    {
      "name": "Variables",
      "scope": "variable",
      "foreground": "#e8e4df"
    },
    {
      "name": "Properties",
      "scope": "variable.other.property, meta.property-name",
      "foreground": "#7a9ce0"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "#a8a29a"
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "foreground": "#b890d8"
    },
    {
      "name": "Attributes",
      "scope": "entity.other.attribute-name",
      "foreground": "#7a9ce0"
    },
    {
      "name": "Markup headings",
      "scope": "markup.heading",
      "foreground": "#b890d8",
      "bold": true
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "foreground": "#e8e4df",
      "bold": true
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "foreground": "#e8e4df",
      "italic": true
    },
    {
      "name": "Markup links",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#7a9ce0",
      "underline": true
    },
    {
      "name": "Diff added",
      "scope": "markup.inserted",
      "foreground": "#7cc070"
    },
    {
      "name": "Diff removed",
      "scope": "markup.deleted",
      "foreground": "#e07a6d"
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "foreground": "#d8b85a"
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "#e07a6d",
      "bold": true
    }
  ]
}
